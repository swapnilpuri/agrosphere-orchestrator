{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        }
      },
      "required": [
        "repository",
        "path",
        "sha256",
        "revision"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ContextReference": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head"
        }
      },
      "required": [
        "repository",
        "path",
        "sha256"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "ContractProposal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "openapi",
            "event-schema"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "requirement_ids",
        "version"
      ],
      "title": "ContractProposal",
      "type": "object"
    },
    "DesignInput": {
      "additionalProperties": false,
      "properties": {
        "documentation_scope": {
          "default": "application",
          "enum": [
            "application",
            "internal-orchestrator"
          ],
          "title": "Documentation Scope",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/MilestoneSpec"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "context": {
          "items": {
            "$ref": "#/$defs/ContextReference"
          },
          "minItems": 1,
          "title": "Context",
          "type": "array"
        },
        "narratives": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Narratives",
          "type": "object"
        },
        "diagrams": {
          "items": {
            "$ref": "#/$defs/DiagramSpec"
          },
          "title": "Diagrams",
          "type": "array"
        },
        "contracts": {
          "items": {
            "$ref": "#/$defs/ContractProposal"
          },
          "title": "Contracts",
          "type": "array"
        },
        "contract_impact": {
          "default": false,
          "title": "Contract Impact",
          "type": "boolean"
        }
      },
      "required": [
        "plan",
        "requirements",
        "context"
      ],
      "title": "DesignInput",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "label"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "DiagramSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "context",
            "container",
            "component",
            "sequence",
            "domain",
            "activity",
            "state",
            "data-flow",
            "deployment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "approved_source": {
          "anyOf": [
            {
              "maxLength": 200000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Source"
        }
      },
      "required": [
        "id",
        "kind",
        "repository",
        "requirement_ids",
        "nodes",
        "rationale"
      ],
      "title": "DiagramSpec",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "READ_ONLY",
        "WORKTREE_WRITE",
        "VALIDATION_ONLY"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "project": {
          "default": "agrosphere",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Project",
          "type": "string"
        },
        "milestone": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Milestone",
          "type": "string"
        },
        "units": {
          "items": {
            "$ref": "#/$defs/Unit"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Units",
          "type": "array"
        }
      },
      "required": [
        "milestone",
        "units"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "MilestoneSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "project": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Project",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project",
        "title",
        "tasks"
      ],
      "title": "MilestoneSpec",
      "type": "object"
    },
    "Remote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "owner": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$",
          "title": "Owner",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "owner",
        "name"
      ],
      "title": "Remote",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "acceptance_criteria"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RunLimits": {
      "additionalProperties": false,
      "properties": {
        "max_milestones": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Max Milestones",
          "type": "integer"
        },
        "max_tasks": {
          "default": 20,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Tasks",
          "type": "integer"
        },
        "max_concurrency": {
          "default": 2,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_invocations": {
          "default": 30,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Invocations",
          "type": "integer"
        },
        "max_attempts": {
          "default": 30,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_repairs": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "max_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "max_poll_seconds": {
          "default": 60,
          "maximum": 300,
          "minimum": 0,
          "title": "Max Poll Seconds",
          "type": "integer"
        },
        "max_steps": {
          "default": 50,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_model_cost": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Cost"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "TaskOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ExecutionMode",
          "default": "READ_ONLY"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Inputs",
          "type": "array"
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "title": "Expected Outputs",
          "type": "array"
        },
        "validation_commands": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Validation Commands",
          "type": "array"
        },
        "resources": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "complexity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complexity"
        },
        "specialization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specialization"
        },
        "max_repairs": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "approval_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Approval Requirements",
          "type": "array"
        }
      },
      "title": "TaskOptions",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Role",
          "type": "string"
        },
        "operation": {
          "default": "plan",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Operation",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "repository",
        "role",
        "acceptance_criteria"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "Unit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "remote": {
          "$ref": "#/$defs/Remote"
        },
        "base": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Base",
          "type": "string"
        },
        "branch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "base_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "draft": {
          "default": false,
          "title": "Draft",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "task",
        "repository",
        "root",
        "remote",
        "base",
        "branch",
        "base_sha",
        "head_sha"
      ],
      "title": "Unit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "milestone": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Milestone",
      "type": "string"
    },
    "mode": {
      "default": "dry-run",
      "pattern": "^(dry-run|local|controlled-delivery)$",
      "title": "Mode",
      "type": "string"
    },
    "requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/DesignInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_options": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/TaskOptions"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Options"
    },
    "delivery_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "publication_grants": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Publication Grants",
      "type": "object"
    },
    "limits": {
      "$ref": "#/$defs/RunLimits"
    }
  },
  "required": [
    "milestone"
  ],
  "title": "AutonomousRequest",
  "type": "object"
}
