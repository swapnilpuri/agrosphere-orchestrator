{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer"
        }
      },
      "required": [
        "repository",
        "path",
        "sha256",
        "revision"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ExecutionMode": {
      "enum": [
        "READ_ONLY",
        "WORKTREE_WRITE",
        "VALIDATION_ONLY"
      ],
      "title": "ExecutionMode",
      "type": "string"
    },
    "MilestoneSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "project": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Project",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project",
        "title",
        "tasks"
      ],
      "title": "MilestoneSpec",
      "type": "object"
    },
    "TaskOptions": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ExecutionMode",
          "default": "READ_ONLY"
        },
        "allowed_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Paths",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Inputs",
          "type": "array"
        },
        "expected_outputs": {
          "items": {
            "type": "string"
          },
          "title": "Expected Outputs",
          "type": "array"
        },
        "validation_commands": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Validation Commands",
          "type": "array"
        },
        "resources": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "complexity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complexity"
        },
        "specialization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Specialization"
        },
        "max_repairs": {
          "default": 3,
          "maximum": 3,
          "minimum": 0,
          "title": "Max Repairs",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "approval_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Approval Requirements",
          "type": "array"
        }
      },
      "title": "TaskOptions",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Role",
          "type": "string"
        },
        "operation": {
          "default": "plan",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Operation",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "repository",
        "role",
        "acceptance_criteria"
      ],
      "title": "TaskSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "milestone": {
      "$ref": "#/$defs/MilestoneSpec"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "design_revision": {
      "title": "Design Revision",
      "type": "string"
    },
    "tasks": {
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_.-]*$": {
          "$ref": "#/$defs/TaskOptions"
        }
      },
      "propertyNames": {
        "maxLength": 128
      },
      "title": "Tasks",
      "type": "object"
    },
    "proposed_by": {
      "default": "project-manager",
      "title": "Proposed By",
      "type": "string"
    },
    "reviewed_by": {
      "default": "program-manager",
      "title": "Reviewed By",
      "type": "string"
    }
  },
  "required": [
    "milestone",
    "design_revision",
    "tasks"
  ],
  "title": "ExecutionPlan",
  "type": "object"
}
