        {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Producer"
    }
  },
  "required": [
    "repository",
    "path",
    "sha256",
    "revision"
