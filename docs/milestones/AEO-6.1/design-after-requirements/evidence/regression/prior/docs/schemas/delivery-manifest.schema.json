{
  "$defs": {
    "Remote": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "owner": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$",
          "title": "Owner",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "owner",
        "name"
      ],
      "title": "Remote",
      "type": "object"
    },
    "Unit": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "root": {
          "format": "path",
          "title": "Root",
          "type": "string"
        },
        "remote": {
          "$ref": "#/$defs/Remote"
        },
        "base": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Base",
          "type": "string"
        },
        "branch": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "base_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "head_sha": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Head Sha",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "draft": {
          "default": false,
          "title": "Draft",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "task",
        "repository",
        "root",
        "remote",
        "base",
        "branch",
        "base_sha",
        "head_sha"
      ],
      "title": "Unit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project": {
      "default": "agrosphere",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Project",
      "type": "string"
    },
    "milestone": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Milestone",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/Unit"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Units",
      "type": "array"
    }
  },
  "required": [
    "milestone",
    "units"
  ],
  "title": "Manifest",
  "type": "object"
}
