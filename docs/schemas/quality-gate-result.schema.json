{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "HIGH"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        }
      },
      "required": [
        "id",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GateState": {
      "enum": [
        "PENDING",
        "RUNNING",
        "PASSED",
        "FAILED",
        "BLOCKED",
        "SKIPPED",
        "ERROR"
      ],
      "title": "GateState",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFORMATIONAL"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "gate_id": {
      "title": "Gate Id",
      "type": "string"
    },
    "execution_id": {
      "title": "Execution Id",
      "type": "string"
    },
    "repository": {
      "title": "Repository",
      "type": "string"
    },
    "artifact_hash": {
      "title": "Artifact Hash",
      "type": "string"
    },
    "validator_version": {
      "title": "Validator Version",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "title": "Ended At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/GateState"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "integer"
    },
    "test_cases": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Test Cases",
      "type": "object"
    },
    "coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "gate_id",
    "execution_id",
    "repository",
    "artifact_hash",
    "validator_version",
    "started_at",
    "ended_at",
    "state",
    "policy_version"
  ],
  "title": "GateResult",
  "type": "object"
}
