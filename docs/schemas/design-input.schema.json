{
  "$defs": {
    "ContextReference": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "head": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Head"
        }
      },
      "required": [
        "repository",
        "path",
        "sha256"
      ],
      "title": "ContextReference",
      "type": "object"
    },
    "ContractProposal": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "openapi",
            "event-schema"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "requirement_ids",
        "version"
      ],
      "title": "ContractProposal",
      "type": "object"
    },
    "DiagramEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "label"
      ],
      "title": "DiagramEdge",
      "type": "object"
    },
    "DiagramNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "DiagramNode",
      "type": "object"
    },
    "DiagramSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "context",
            "container",
            "component",
            "sequence",
            "domain",
            "activity",
            "state",
            "data-flow",
            "deployment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DiagramNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/DiagramEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "repository",
        "requirement_ids",
        "nodes",
        "rationale"
      ],
      "title": "DiagramSpec",
      "type": "object"
    },
    "MilestoneSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "project": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Project",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project",
        "title",
        "tasks"
      ],
      "title": "MilestoneSpec",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "acceptance_criteria"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "repository": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Repository",
          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Role",
          "type": "string"
        },
        "operation": {
          "default": "plan",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Operation",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "repository",
        "role",
        "acceptance_criteria"
      ],
      "title": "TaskSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan": {
      "$ref": "#/$defs/MilestoneSpec"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "context": {
      "items": {
        "$ref": "#/$defs/ContextReference"
      },
      "minItems": 1,
      "title": "Context",
      "type": "array"
    },
    "narratives": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Narratives",
      "type": "object"
    },
    "diagrams": {
      "items": {
        "$ref": "#/$defs/DiagramSpec"
      },
      "title": "Diagrams",
      "type": "array"
    },
    "contracts": {
      "items": {
        "$ref": "#/$defs/ContractProposal"
      },
      "title": "Contracts",
      "type": "array"
    },
    "contract_impact": {
      "default": false,
      "title": "Contract Impact",
      "type": "boolean"
    }
  },
  "required": [
    "plan",
    "requirements",
    "context"
  ],
  "title": "DesignInput",
  "type": "object"
}
