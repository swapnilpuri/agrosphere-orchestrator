AEO_DATABASE_URL=sqlite:///aeo.db
AEO_REPOSITORY_MANIFEST=config/repositories.yaml
AEO_ROLE_REGISTRY=config/roles.yaml
AEO_APPROVAL_POLICY=config/approvals.yaml
AEO_LOG_LEVEL=INFO

AEO_WORKSPACE_ROOT=..
AEO_RECOVERY_DIRECTORY=project

# Empty allowlist fails closed; configure canonical Windows SID identities as administrator.
AEO_DESIGN_APPROVERS=[]
# AEO_PLANTUML_JAR=C:/trusted-tools/plantuml.jar
AEO_JAVA_EXECUTABLE=java

# AEO-2 defaults remain offline; use a native executable path when needed.
AEO_CODEX_EXECUTABLE=codex
AEO_CODEX_STARTUP_ARGUMENTS=[]
AEO_CODEX_TRANSPORT=auto
AEO_EXECUTION_ROOT=.aeo/executions
AEO_EXECUTION_POLICY=config/execution.yaml
AEO_EXECUTION_APPROVERS=[]
# AEO_CODEX_MODEL=<explicit intended model>
# Store CODEX_API_KEY securely only if using API-key auth; never put it in prompts.

# AEO-4: no default human approvers; policies require authenticated activation.
AEO_QUALITY_POLICY=config/quality.yaml
AEO_GOVERNANCE_APPROVERS=[]
